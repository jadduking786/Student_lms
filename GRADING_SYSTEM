# ============================================================
#        STUDENT MANAGEMENT & GRADE SYSTEM
# ============================================================

# ---------------- CONSTANTS ----------------

PASS_MARKS = 50
TOTAL_SUBJECTS = 5
MAX_MARKS = 100


# ---------------- FUNCTIONS ----------------

# Function to calculate total marks
def calculate_total(marks):
    return sum(marks)


# Function to calculate average
def calculate_average(marks):
    total = calculate_total(marks)
    average = total / len(marks)

    return average


# Function to calculate grade
def calculate_grade(average):

    if average >= 90:
        return "A+"

    elif average >= 80:
        return "A"

    elif average >= 70:
        return "B"

    elif average >= 60:
        return "C"

    elif average >= 50:
        return "D"

    else:
        return "F"


# Function to check result
def check_result(average):

    if average >= PASS_MARKS:
        return "PASS"

    else:
        return "FAIL"


# Function to display student report
def display_report(name, marks):

    print("\n========================================")
    print("          STUDENT REPORT")
    print("========================================")

    print("Name:", name)

    print("Marks:", marks)

    # Built-in functions
    print("Number of Subjects:", len(marks))
    print("Highest Marks:", max(marks))
    print("Lowest Marks:", min(marks))

    # Function calls
    total = calculate_total(marks)
    average = calculate_average(marks)
    grade = calculate_grade(average)
    result = check_result(average)

    print("Total Marks:", total)
    print("Average:", average)
    print("Grade:", grade)
    print("Result:", result)

    # Conditional statement
    if average >= 90:
        print("Performance: Excellent!")

    elif average >= 70:
        print("Performance: Very Good!")

    elif average >= 50:
        print("Performance: Good!")

    else:
        print("Performance: Needs Improvement!")


# ============================================================
#                    MAIN PROGRAM
# ============================================================

print("========================================")
print("     STUDENT MANAGEMENT SYSTEM")
print("========================================")


# ---------------- LIST ----------------

students = []


# ---------------- TYPE CASTING ----------------

number_of_students = int(
    input("Enter number of students: ")
)


# ============================================================
#              FOR LOOP FOR STUDENTS
# ============================================================

for student_number in range(1, number_of_students + 1):

    print("\n----------------------------------------")
    print("Enter information for Student", student_number)
    print("----------------------------------------")

    name = input("Enter student name: ")

    # Add name to students list
    students.append(name)


    # Create marks list
    marks = []


    # ========================================================
    #              WHILE LOOP FOR MARKS
    # ========================================================

    subject = 1

    while subject <= TOTAL_SUBJECTS:

        print("\nSubject", subject)

        marks_input = input(
            "Enter marks (0-100): "
        )

        # Type casting
        mark = float(marks_input)


        # ====================================================
        #              CONDITIONAL STATEMENT
        # ====================================================

        if mark < 0 or mark > MAX_MARKS:

            print("Invalid marks!")

            # CONTINUE
            continue


        # Add marks to list
        marks.append(mark)

        subject += 1


    # ========================================================
    #                 DISPLAY REPORT
    # ========================================================

    display_report(name, marks)


# ============================================================
#              DISPLAY ALL STUDENTS
# ============================================================

print("\n========================================")
print("          ALL STUDENTS")
print("========================================")


# FOR LOOP THROUGH LIST

for student in students:

    print(student)


# ============================================================
#                 BREAK EXAMPLE
# ============================================================

print("\n========================================")
print("          STUDENT SEARCH")
print("========================================")

search_name = input(
    "Enter student name to search: "
)

found = True


for student in students:

    if student == search_name:

        print("Student found:", student)

        found = True

        # BREAK
        break


if found == False:

    print("Student not found.")


# ============================================================
#                    PROGRAM END
# ============================================================

print("\n========================================")
print("        PROGRAM COMPLETED")
print("========================================")
